{
  "name": "Monitor de Milhas",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "minutes", "minutesInterval": 30 }]
        }
      },
      "id": "schedule-trigger",
      "name": "A cada 30 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://milhas-scraper:3000/search",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "origin", "value": "GRU" },
            { "name": "destination", "value": "MIA" },
            { "name": "date", "value": "2026-12-15" },
            { "name": "program", "value": "smiles,latampass,tudoazul" }
          ]
        },
        "options": { "timeout": 60000 }
      },
      "id": "http-search",
      "name": "Buscar voos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "fieldToSplitOut": "flights",
        "options": {}
      },
      "id": "split-flights",
      "name": "Separar voos",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [440, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "leftValue": "={{ $json.miles }}",
              "rightValue": 15000,
              "operator": { "type": "number", "operation": "lt" }
            },
            {
              "leftValue": "={{ $json.taxes }}",
              "rightValue": 100,
              "operator": { "type": "number", "operation": "lt" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "filter-cheap",
      "name": "Filtrar ofertas baratas",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [660, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://evolution-api:8080/message/sendText/SEU_INSTANCE_NAME",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "apikey", "value": "SUA_API_KEY_EVOLUTION" }]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"number\": \"55SEUNUMERO\", \"text\": \"🔥 Passagem encontrada!\\nTrecho: \" + $json.origin + \" → \" + $json.destination + \"\\nData: \" + $json.date + \"\\nPrograma: \" + $json.program + \"\\nMilhas: \" + $json.miles + \" + R$ \" + $json.taxes + \" de taxa\\nLink: \" + $json.link } }}"
      },
      "id": "send-whatsapp",
      "name": "Enviar WhatsApp (Evolution API)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 0]
    }
  ],
  "connections": {
    "A cada 30 min": { "main": [[{ "node": "Buscar voos", "type": "main", "index": 0 }]] },
    "Buscar voos": { "main": [[{ "node": "Separar voos", "type": "main", "index": 0 }]] },
    "Separar voos": { "main": [[{ "node": "Filtrar ofertas baratas", "type": "main", "index": 0 }]] },
    "Filtrar ofertas baratas": { "main": [[{ "node": "Enviar WhatsApp (Evolution API)", "type": "main", "index": 0 }]] }
  }
}
