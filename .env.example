PORT=3000

# --- Supabase (Auth + Postgres) ---
# URL e chave pública: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=
# Mesmos valores, expostos também sem o prefixo VITE_ pro server-side (SSR)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=
# service_role — bypassa RLS, só usado em *.server.ts. NUNCA expor no client.
SUPABASE_SERVICE_ROLE_KEY=

# Segredo compartilhado com o workflow do n8n que chama
# GET /api/cron/send-scheduled-messages (header x-cron-secret)
CRON_SECRET=troque-por-uma-string-aleatoria-longa

# Link de convite do grupo gratuito (WhatsApp ou Telegram)
FREE_GROUP_URL=https://chat.whatsapp.com/SEU_LINK_AQUI

# --- Evolution API (instância DEDICADA para o grupo, não a de atendimento) ---
EVOLUTION_API_URL=http://curso_evolution-api:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
WHATSAPP_GROUP_JID=
