PORT=3000

# Timeout de navegação do Playwright por busca (ms)
SCRAPE_TIMEOUT_MS=45000

# true para ver o navegador durante debug local (não usar em produção)
PLAYWRIGHT_HEADLESS=true

# Link de convite do grupo gratuito (WhatsApp ou Telegram) — troque quando o grupo existir
FREE_GROUP_URL=https://chat.whatsapp.com/SEU_LINK_AQUI

# Connection string do Postgres usado para salvar os leads (tabela "leads")
DATABASE_URL=postgres://usuario:senha@host:5432/tgestmilhas

# --- Painel admin (/admin) ---
SESSION_SECRET=troque-por-uma-string-aleatoria-longa
# Usados só na primeira vez, para criar o admin inicial (se admin_users estiver vazia)
ADMIN_BOOTSTRAP_USER=admin
ADMIN_BOOTSTRAP_PASSWORD=troque-por-uma-senha-forte

# --- Evolution API (instância DEDICADA para o grupo, não a de atendimento) ---
EVOLUTION_API_URL=http://curso_evolution-api:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
WHATSAPP_GROUP_JID=

# --- seats.aero (busca de milhas para Smiles e TudoAzul; LATAM Pass não é
# suportado por essa API, continua via scraper) ---
SEATS_AERO_API_KEY=
